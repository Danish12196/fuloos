# Set only after installing pocketbase/pb_migrations on your server.
# Public URL only — no admin or superuser credentials belong in the frontend.
VITE_POCKETBASE_URL=
# Example: https://pb.danishali.dev
# Optional: URL of the hashed Ledger categoriser model (made with scripts/ledger/hash-model.ts).
# Host it outside this repository. Without it, SMS import uses brand and keyword rules only.
VITE_LEDGER_MODEL_URL=
